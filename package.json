{
  "name": "mcoweblab-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives Claude tools over MCO WebLab's services, quotes and size charts, plus a Claude skill for bilingual product descriptions.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "check-skill": "node skills/bilingual-product-descriptions/scripts/check_description.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "bin": {
    "mcoweblab-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
